{
  "manifest_version": 3,
  "name": "Hypno",
  "version": "1.0.0",
  "description": "A lightweight web reconnaissance extension for extract endpoints & parameters from a page (JSON, HTML inputs, link params, XML attributes, JS vars).",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }
  ],
  "action": {
    "default_title": "Hypno",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}